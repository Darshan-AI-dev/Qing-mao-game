    {
      "op": "line",
      "actor": "narrator",
      "text": "The crevice opens wider than it looked. Inside, the dark has a shape to it, and the shape is large.",
      "kind": "narration",
      "sfx": null
    },
    {
      "op": "line",
      "actor": "fang-yuan",
      "text": "Carry the light. Whatever is in here has been in here a long time and is in no hurry.",
      "kind": "thought",
      "sfx": null
    },
    {
      "op": "evidence",
      "add": "cave.entry-traces"
    },
    {
      "op": "title",
      "chapter": 15,
      "text": "A witness in the wall"
    },
    {
      "op": "camera",
      "to": [
        -5,
        2.6,
        10
