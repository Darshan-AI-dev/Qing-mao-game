    {
      "op": "line",
      "actor": "narrator",
      "text": "Something very old turns over, without waking.",
      "kind": "narration",
      "sfx": null
    },
    {
      "op": "line",
      "actor": "narrator",
      "text": "The resistance goes out of the worm like water out of a cracked jar.",
      "kind": "narration",
      "sfx": null
    },
    {
      "op": "line",
      "actor": "fang-yuan",
      "text": "Nobody on this mountain can explain what just happened. Including me, in any useful detail.",
      "kind": "thought",
      "sfx": null
