      "look": [
        0,
        1.6,
        34
      ],
      "seconds": 2.2
    },
    {
      "op": "line",
      "actor": "fang-yuan",
      "text": "Crushed bamboo, a scuffed ledge, one print in wet clay. Ordinary on their own.",
      "kind": "thought",
      "sfx": null
    },
    {
      "op": "line",
      "actor": "fang-yuan",
      "text": "Together they are a direction, for anyone who thinks to look.",
      "kind": "thought",
      "sfx": null
    },
    {
      "op": "choice",
      "id": "cave.traces",
      "prompt": "The approach you came in by.",
      "method": "cave",
      "options": [
        {
          "id": "brush-out",
          "label": "Spend the evening making it look like weather.",
          "method": "careful"
        },
        {
          "id": "leave-it",
          "label": "Leave it. Nobody comes up here.",
          "method": "fast"
        }
      ]
    },
    {
      "op": "title",
      "chapter": 17,
      "text": "It will not be taken by hand"
