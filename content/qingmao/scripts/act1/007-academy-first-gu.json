    {
      "op": "line",
      "actor": "tavern-keeper",
      "text": "Green Bamboo Wine. Two stones, and I will not pretend it is worth two stones to drink.",
      "kind": "spoken",
      "sfx": null
    },
    {
      "op": "line",
      "actor": "fang-yuan",
      "text": "Twelve stones. Two of them is a sixth of everything I have, spent on a smell.",
      "kind": "thought",
      "sfx": null
    },
    {
