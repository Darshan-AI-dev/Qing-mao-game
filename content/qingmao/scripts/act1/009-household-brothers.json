    {
      "op": "line",
      "actor": "fang-yuan",
      "text": "Fourth time he has said nephew. Three more than the sentence needed.",
      "kind": "thought",
      "sfx": null
    },
    {
      "op": "line",
      "actor": "fang-qiu-wife",
      "text": "We have kept the accounts in good order all these years. Nobody can say otherwise.",
      "kind": "spoken",
      "sfx": null
    },
    {
      "op": "line",
      "actor": "fang-yuan",
      "text": "Nobody has asked.",
      "kind": "thought",
      "sfx": null
    },
    {
      "op": "title",
      "chapter": 10,
      "text": "An itemised kindness"
    },
    {
      "op": "gesture",
      "actor": "fang-qiu-wife",
      "gesture": "talk-cross-arms"
    },
    {
      "op": "line",
      "actor": "fang-qiu-wife",
      "text": "The roof, the rice, the academy fees. Two boys is not a small thing to carry.",
      "kind": "spoken",
      "sfx": null
    },
    {
      "op": "line",
      "actor": "fang-qiu",
      "text": "She means it kindly.",
      "kind": "spoken",
      "sfx": null
    },
    {
      "op": "line",
      "actor": "fang-yuan",
      "text": "She means it as an invoice. He means it as a receipt.",
      "kind": "thought",
      "sfx": null
    },
    {
      "op": "choice",
      "id": "household.records",
      "prompt": "The accounts are on the table.",
