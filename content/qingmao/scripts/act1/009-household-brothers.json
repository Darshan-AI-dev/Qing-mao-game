        },
        {
          "id": "say-nothing",
          "label": "Let them finish and take the tea.",
          "method": "patient"
        },
        {
          "id": "push",
          "label": "Say the property was your father's.",
          "method": "direct"
        }
      ]
    },
    {
      "op": "line",
      "actor": "fang-qiu",
      "text": "That is — we will find the year. It will be written somewhere.",
